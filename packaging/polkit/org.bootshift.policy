<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed to /usr/share/polkit-1/actions/. -->
<policyconfig>
  <vendor>Kitten</vendor>

  <!--
    Accepted design decision (see SECURITY.md threat model): the inspect action is read-only. It
    lists disks and runs Kitten's safety checks, which drive probe tools (lsblk, blkid, dumpe2fs,
    findmnt) as root but never write to a disk, so an active local user may run it without a
    password (allow_active=yes) and the GUI can show the layout on open. It discloses only partition
    layout to someone already at the active session; device paths are exact-matched against the
    enumerated disks and no value reaches a shell. Every MUTATING operation is the separate `apply`
    action below, which always requires admin authentication.
  -->
  <action id="org.bootshift.inspect">
    <description>Read the disk layout and run Kitten's safety checks</description>
    <message>Authentication is required to read the disk layout</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Never auth_admin_keep: each change must be confirmed on its own. -->
  <action id="org.bootshift.apply">
    <description>Rearrange the partitions on a disk</description>
    <message>Authentication is required to rearrange the partitions on this disk</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
