# Installed to /usr/lib/systemd/system/. Started by D-Bus activation, not at boot.
[Unit]
Description=Kitten partition helper

[Service]
Type=dbus
BusName=org.bootshift.Helper1
ExecStart=/usr/libexec/bootshift/bootshiftd

# Hardening. The helper runs as root and drives disk tools, so it needs raw block
# device and tool access; the sandbox below removes everything it does NOT need.
# Deliberately NOT set, because they would break the helper's job:
#   PrivateDevices / ProtectSystem=strict  -> needed to read/write /dev/<disk> and the ESP.
NoNewPrivileges=yes
# These debug-only overrides are also compiled out of release builds; clearing them here is
# defence in depth so a stray environment entry can never reach the service. SKIP_POLKIT would
# waive authorization; EXTRA_KERNEL_ARGS would inject arguments into the recovery boot command line.
UnsetEnvironment=BOOTSHIFT_SKIP_POLKIT
UnsetEnvironment=BOOTSHIFT_EXTRA_KERNEL_ARGS
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
